{
  "name": "agent-things-dsh",
  "version": "1.3.4",
  "description": "Agent Things progress rings, source-linked AI to-dos, and /things cards for DeepSeek Harness",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "snuffpic",
  "homepage": "https://github.com/snuffpic/agent-things#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snuffpic/agent-things.git",
    "directory": "packages/dsh-agent-things"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "things",
    "task-manager",
    "session-status"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.1.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "package.json",
    "README.md",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "bin/dsh-mcp.cjs",
    "src/**/*",
    "lib/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": true
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
