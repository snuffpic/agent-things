{
  "name": "agent-things",
  "version": "1.2.1",
  "description": "Session task progress and checklists for ChatGPT, Antigravity and Claude Desktop on macOS.",
  "license": "MIT",
  "author": "snuffpic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snuffpic/agent-things.git"
  },
  "homepage": "https://github.com/snuffpic/agent-things#readme",
  "bugs": {
    "url": "https://github.com/snuffpic/agent-things/issues"
  },
  "type": "commonjs",
  "bin": {
    "agent-things": "bin/codex-session-status.cjs",
    "codex-session-status": "bin/codex-session-status.cjs",
    "antigravity-session-status": "bin/antigravity-session-status.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "test": "SESSION_STATUS_PORT=0 SESSION_STATUS_CONFIG=/tmp/agent-things-test-isolated-config.json node --test --test-timeout=60000 test/*.test.cjs",
    "build:bundles": "node scripts/build-shared-ui.cjs && node scripts/build-antigravity-bundle.cjs && node scripts/build-codex-bundle.cjs",
    "build:bridge": "node scripts/build-native-bridge.cjs",
    "prepack": "npm run build:bridge && npm run build:bundles",
    "mcp": "node bin/codex-session-status.cjs mcp",
    "mcp:antigravity": "node bin/antigravity-session-status.cjs",
    "check:syntax": "node scripts/check.cjs",
    "check:package": "node scripts/check-package.cjs",
    "check:browser": "SESSION_STATUS_CONFIG=/tmp/agent-things-test-isolated-config.json AGENT_THINGS_CHECK_HOST=codex node scripts/check-session-status.cjs",
    "verify": "npm run check:syntax && npm run build:bridge && npm run build:bundles && git diff --exit-code -- outputs/ mods/agent-things-ui/hooks/foundation.js && npm test && npm run check:browser && npm run check:package"
  },
  "keywords": [
    "agent",
    "antigravity",
    "codex",
    "mcp",
    "task-manager",
    "gtd",
    "session-status",
    "ai-agent"
  ],
  "files": [
    "bin/*.cjs",
    "src/**/*.cjs",
    "src/**/*.js",
    "src/plugins/things/**",
    "src/analysis-assets/*.txt",
    "src/analysis-assets/*.json",
    "outputs/*.js",
    "LICENSE",
    "NOTICE",
    "native/*.swift",
    "native/bin/bridge",
    "native/bin/bridge.json",
    "skills/**/*.md",
    "mods/agent-things-ui/.claude-plugin/plugin.json",
    "mods/agent-things-ui/SKILL.md",
    "mods/agent-things-ui/hooks/*.js",
    "mods/agent-things-ui/hooks/*.json",
    "scripts/setup-antigravity-service.cjs",
    "scripts/setup-claude-service.cjs",
    "scripts/build-native-bridge.cjs",
    "scripts/build-*-bundle.cjs",
    "scripts/build-shared-ui.cjs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
